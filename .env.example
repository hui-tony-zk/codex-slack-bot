# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=

# Slack App Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=

# Optional comma-separated channel:user pairs; configured channels ignore all other users
CHANNEL_USER_ALLOWLIST=

# Default working directory for agent sessions
DEFAULT_CWD=/path/to/your/projects

# Optional: max turns per request (prevents runaway sessions)
MAX_TURNS=50
